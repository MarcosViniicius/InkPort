# ---------------------------------------------------------------------------
# InkPort configuration. Copy to ".env" and edit.
# Every value can also be provided as a real environment variable.
# ---------------------------------------------------------------------------

APP_NAME=InkPort
DEBUG=false

# --- Rede ------------------------------------------------------------------
# Interface onde o servidor escuta. 0.0.0.0 = toda a rede local.
HOST=0.0.0.0
PORT=8080

# URL base usada para montar os links OPDS/RSS.
# Deixe VAZIO para detecção automática: o servidor descobre o IP da LAN
# (ex.: http://192.168.1.50:8080) quando HOST=0.0.0.0.
# Defina manualmente se estiver atrás de proxy reverso ou rodando em Docker.
BASE_URL=

# Confie em cabeçalhos X-Forwarded-* (só habilite atrás de um proxy seu).
TRUST_PROXY=false
# Usar o endereço que o cliente usou (cabeçalho Host) ao montar os links.
# É o que faz o catálogo funcionar por Tailscale, VPN, IP da LAN ou domínio.
# Defina false apenas se precisar anunciar sempre a BASE_URL.
USE_REQUEST_HOST=true

# --- Storage ---------------------------------------------------------------
# Root folder for the database, library, inbox, temp and covers.
DATA_DIR=./data
# Refuse uploads larger than this (MB).
MAX_UPLOAD_MB=2048
# Soft storage ceiling for the library in GB (0 = unlimited).
STORAGE_LIMIT_GB=0

# --- Security --------------------------------------------------------------
# CHANGE THIS. Used to sign session cookies.
SECRET_KEY=change-me-please-use-a-long-random-string

# Credenciais do painel NAO se definem aqui: no primeiro acesso o servidor abre
# o assistente (/setup) e guarda usuario/senha no banco cifrado. As variaveis
# ADMIN_USERNAME/ADMIN_PASSWORD sao ignoradas -- quem as tinha no .env passa
# pelo assistente uma vez para assumir a credencial.

# Optional HTTP Basic protection for OPDS clients. Empty = disabled.
# (Many e-readers can only authenticate via Basic auth in the catalog URL.)
OPDS_USERNAME=
OPDS_PASSWORD=

# O que a raiz /opds entrega:
#   mixed      -> livros recentes E as secoes (padrao; funciona no CrossPoint)
#   navigation -> somente as secoes, sem livros (para leitores de celular)
#   books      -> somente os livros (as secoes ficam em /opds/browse)
OPDS_ROOT_MODE=mixed
# Protect the web panel behind login. Keep true unless running behind a proxy.
REQUIRE_AUTH_PANEL=true

# --- Workers ---------------------------------------------------------------
# How many conversions may run at the same time.
CONVERSION_CONCURRENCY=2
# Hard timeout per conversion, seconds.
CONVERSION_TIMEOUT=1800
# Poll interval for the queue, seconds.
WORKER_POLL_INTERVAL=2
# Enable the periodic RSS/Atom fetcher.
RSS_WORKER_ENABLED=true

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# Emit one JSON object per line (nice for journald/Docker) instead of text.
LOG_JSON=false

# --- External tools (leave empty to auto-detect from PATH) -----------------
#OPCIONAL: o servidor converte tudo em Python. Preencha apenas se quiser usar
#alguma ferramenta externa que ja exista na maquina (Calibre ajuda em .lit/.odt).
CALIBRE_EBOOK_CONVERT=
IMAGEMAGICK_BIN=
GHOSTSCRIPT_BIN=
FFMPEG_BIN=

# --- Cifragem do banco (SQLCipher) -----------------------------------------
# Deixe em "auto": o banco fica cifrado em repouso usando o pacote sqlcipher3
# (vem na roda, nada a instalar no sistema). A chave e' criada em
# DATA_DIR/secret.key e um banco antigo em texto puro e' migrado no primeiro
# boot, com backup em opds.db.plain.bak.
# ATENCAO: sem a secret.key o opds.db e' ilegivel -- faca backup dos dois juntos.
# Use "off" somente se a plataforma nao tiver a roda (o banco fica em TEXTO PURO).
DB_ENCRYPTION=auto
